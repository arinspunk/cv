		<!-- Header - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
		<header class="c-header{{ if variant === 'blog' }} c-header--blog{{ /if }}">
			<div class="o-wrap">
				<div class="c-header__logo o-block">
					{{- if variant === "blog" }}
					<a class="c-header__logo-link" href="{{ t.cvUrl }}" title="{{ t.logoTitle }}">
						XZ
					</a>
					{{- else }}
					XZ
					{{- /if }}
				</div>
				<nav class="c-header__menu o-block">
					<ul class="c-header__menu-list">
						{{- for other of i18n.headerLanguages }}
						{{- set alternate = other !== lang && alternates?.find((a) => a.lang === other) }}
						{{- if alternate }}
						<li class="c-header__menu-item c-header__menu-item--language">
							<a class="c-header__menu-link" href="{{ alternate.url }}" title="{{ i18n[other].langTitle }}">
								{{ i18n[other].langLabel }}
							</a>
						</li>
						{{- /if }}
						{{- /for }}
						<li class="c-header__menu-item">
							<a class="c-header__menu-link" href="{{ t.cvUrl }}" title="{{ t.cvTitle }}">
								CV
							</a>
						</li>
						<li class="c-header__menu-item">
							<a class="c-header__menu-link" href="{{ t.blogUrl }}" title="{{ t.blogTitle }}">
								{{ t.blogLabel }}
							</a>
						</li>
						<li class="c-header__menu-item">
							<a class="c-header__menu-link c-header__menu-link--btn" href="https://www.linkedin.com/in/xulioze/" title="{{ t.linkedinTitle }}" target="_blank" rel="noopener">
								{{ t.linkedinLabel }}
							</a>
						</li>
					</ul>
				</nav>
			</div>
		</header>
