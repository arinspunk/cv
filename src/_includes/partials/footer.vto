		<!-- Footer - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
		<footer class="c-footer{{ if variant === 'blog' }} c-footer--blog{{ /if }}">
			<div class="o-wrap">
				<nav class="c-footer__menu o-block">
					<ul class="c-footer__menu-list">
						<li class="c-footer__menu-item">
							<a class="c-footer__menu-link" href="https://github.com/arinspunk" target="_blank" rel="noopener" title="{{ t.githubFooterTitle }}">
								GitHub
							</a>
						</li>
						<li class="c-footer__menu-item">
							<a class="c-footer__menu-link" href="mailto:hola@xulioze.com" title="{{ t.emailFooterTitle }}">
								Email
							</a>
						</li>
						<li class="c-footer__menu-item">
							<a class="c-footer__menu-link" href="https://www.linkedin.com/in/xulioze/" target="_blank" rel="noopener" title="{{ t.linkedinFooterTitle }}">
								LinkedIn
							</a>
						</li>
					</ul>
				</nav>
				<p class="o-block c-footer__credits">
					© <span class="c-footer__year"></span> {{ site.author }}
				</p>
			</div>
		</footer>
