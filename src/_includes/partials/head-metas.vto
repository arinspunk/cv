{{- set pageTitle = it.fullTitle ?? `${title} - ${site.author}` }}
{{- set pageUrl = url |> url(true) }}
{{- set imagePath = it.image ?? site.image }}
{{- set imageUrl = imagePath |> url(true) }}
{{- set size = imagePath |> imageSize }}
	<!-- Initials metas -->
	<meta charset="utf-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1">

	<!-- Meta info -->
	<title>{{ pageTitle }}</title>
	<meta property="og:title" content="{{ pageTitle |> escape }}">
	<meta name="twitter:title" content="{{ pageTitle |> escape }}">
	<meta itemprop="name" content="{{ pageTitle |> escape }}">
	{{- if it.description }}
	<meta name="description" content="{{ description |> escape }}">
	<meta property="og:description" content="{{ description |> escape }}">
	<meta name="twitter:description" content="{{ description |> escape }}">
	<meta itemprop="description" content="{{ description |> escape }}">
	{{- /if }}
	<link rel="canonical" href="{{ pageUrl }}">
	<meta property="og:url" content="{{ pageUrl }}">
	<meta name="twitter:url" content="{{ pageUrl }}">
	<meta property="og:image" content="{{ imageUrl }}">
	<meta property="og:image:width" content="{{ size.width }}">
	<meta property="og:image:height" content="{{ size.height }}">
	<meta name="twitter:image" content="{{ imageUrl }}">
	<meta itemprop="image" content="{{ imageUrl }}">
	<meta name="copyright" content="(c) {{ year }} {{ site.author }}">
	<link rel="author" href="/humans.txt">
	<meta name="robots" content="index,follow">
	<meta name="google" content="nositelinkssearchbox">

	<!-- iOS -->
	<meta name="apple-mobile-web-app-title" content="{{ pageTitle |> escape }}">
	<meta name="format-detection" content="telephone=no">
