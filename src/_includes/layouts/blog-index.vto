---
layout: layouts/base.vto
variant: blog
---
{{- set t = i18n[lang] }}
		<!-- Content - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
		<div class="c-info c-info--blog o-wrap o-wrap--center">
{{ content }}
			<div class="c-articles o-block o-block--center">
				{{- for post of search.pages(`type=post lang=${lang}`, "date=desc") }}
				<article class="c-article">
					<time datetime="{{ post.date |> isoDate }}">{{ post.date |> longDate(lang) }}</time>
					<h2 class="h3 c-article__title">
						<a class="c-article__link" href="{{ post.url }}" title="{{ t.readPost }}">
							{{ post.title }}
						</a>
					</h2>
				</article>
				{{- /for }}
			</div>
		</div>
